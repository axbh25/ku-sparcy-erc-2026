src/ku_sparcy_erc/day4_grasp_result*.json
src/ku_sparcy_erc/day4_grasp_result*.json.tmp
/src/ku_sparcy_erc/day4_grasp_results/*
!/src/ku_sparcy_erc/day4_grasp_results/.gitkeep
